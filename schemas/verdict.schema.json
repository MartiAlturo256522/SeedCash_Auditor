{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skeptic verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["real", "reason", "evidence"],
  "properties": {
    "real": { "type": "boolean" },
    "reason": { "type": "string" },
    "evidence": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    }
  }
}
